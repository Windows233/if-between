            {
              "speaker": "我",
              "text": "为什么.....为什么...为什么为什么为什么！",
              "side": "left",
              "portrait": "protagonist/shocked"
            },
            {
              "speaker": "我",
              "text": "凭什么凭什么凭·什·么·",
              "side": "left",
              "portrait": "protagonist/shocked"
            }
          ]
