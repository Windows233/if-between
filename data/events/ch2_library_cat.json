        "ch2/library/first_cat_mediation": true
      },
      "stage": [
        {
          "do": "say",
          "lines": [
            {
              "speaker": "C",
              "text": "（呢喃）不愧是“夜幕之泪”啊",
              "side": "right",
              "portrait": "c/neutral"
            },
            {
              "speaker": "我",
              "text": "？",
              "side": "left",
              "portrait": "protagonist/puzzled"
            },
            {
              "speaker": "C",
              "text": "你来试试吧，我不用武力的话这猫看起来不会乖呢 ^ ^",
              "side": "right",
              "portrait": "c/neutral"
            },
            {
              "speaker": "我",
              "text": "....？这么亲切的人，怎么说出的话怪怪的",
              "side": "left",
              "portrait": "protagonist/thinking"
            },
            {
              "speaker": "我",
              "text": "好",
              "side": "left",
              "portrait": "protagonist/quiet"
            },
            {
              "text": "你伸出手"
            },
            {
              "text": "猫认得那个味道，是那个再次给它爱的人"
            },
            {
              "speaker": "猫",
              "text": "！是你",
              "side": "right"
            },
            {
              "speaker": "我",
              "text": "一直有人在家等你回来。等等，回家了。",
              "side": "left",
              "portrait": "protagonist/quiet"
            },
            {
              "speaker": "猫",
              "text": "......喵",
              "side": "right"
            }
          ]
        }
      ],
      "next": "cat_reward"
    },
