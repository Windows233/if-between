      },
      "stage": [
        {
          "do": "play_sound",
          "path": "res://audio/sfx/时间回溯.wav"
        },
        {
          "do": "personal_anchor_restore"
        },
        {
          "do": "map_actor_variant",
          "actor": "library_cat_visual",
