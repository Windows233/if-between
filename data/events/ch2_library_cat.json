            {
              "speaker": "C",
              "text": "它不愿意接近你。你还缺少能让它认出的东西。",
              "side": "right",
              "portrait": "c/neutral"
            },
            {
              "speaker": "我",
              "text": "也许日记还在教室里。",
              "side": "left",
              "portrait": "protagonist/thinking"
            }
          ]
        }
      ]
    },
    {
      "id": "with_diary",
      "set": {
